{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "preinstall": "node -e \"try{require('fs').unlinkSync('package-lock.json')}catch(e){}; try{require('fs').unlinkSync('yarn.lock')}catch(e){}; if(!process.env.npm_config_user_agent || !/pnpm\\//.test(process.env.npm_config_user_agent)){console.error('Use pnpm instead'); process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "electron:dev": "cross-env NODE_ENV=development electron ./electron/main.cjs",
    "electron:build": "pnpm --filter @workspace/marketflow run build && electron-builder --win --x64"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.marketflow.erp",
    "productName": "MarketFlow ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "artifacts/marketflow/dist/public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarketFlow ERP"
    }
  },
  "private": true,
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
