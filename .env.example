# ============================================================
# MarketFlow ERP — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/marketflow

# JWT Secret (minimum 64 characters, use strong random string)
JWT_SECRET=your-very-long-random-secret-key-here-minimum-64-characters

# JWT Expiry (e.g. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Allowed Origins (comma-separated, leave empty for dev permissive mode)
# In production: ALLOWED_ORIGINS=https://app.marketflow.sa,https://admin.marketflow.sa
ALLOWED_ORIGINS=

# Node environment (development | production)
NODE_ENV=development

# API Server Port
PORT=8080

# Super Admin seed (used only in seeding scripts)
# SUPER_ADMIN_EMAIL=superadmin@marketflow.app
# SUPER_ADMIN_PASSWORD=SuperAdmin@2025
